# 复制成 keystore.properties（此文件不入库）填自己的正式签名。
# 没有 keystore.properties 时，构建会自动退回仓库自带的演示签名（保证 clone 下来就能编译）。
#
# 生成自己的签名：
#   keytool -genkeypair -keystore ../keys/yuedulite-release.jks -alias yuedulite \
#           -keyalg RSA -keysize 2048 -validity 10950 -storetype PKCS12
# 路径相对于 app 模块目录（app/build.gradle 里用 file(...) 解析）。
RELEASE_STORE_FILE=../../keys/yuedulite-1.0.jks
RELEASE_STORE_PASSWORD=改成你的密钥库口令
RELEASE_KEY_ALIAS=yuedulite
RELEASE_KEY_PASSWORD=改成你的私钥口令
